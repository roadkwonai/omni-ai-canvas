{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom","dom.iterable","esnext"], "strict": true,
    "allowJs": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "module": "esnext", "moduleResolution": "bundler", "resolveJsonModule": true,
    "isolatedModules": true, "jsx": "react-jsx", "incremental": true,
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts","app/**/*.ts","app/**/*.tsx","components/**/*.tsx","lib/**/*.ts","scripts/**/*.ts","tests/**/*.ts",".next/types/**/*.ts",".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
