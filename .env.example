DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Antigravity CLI의 개인 계정 경로를 확인한 후 1로 설정
SCENE_ROOM_AGY_PERSONAL=0

# 각 API는 구독과 별도로 과금됩니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
# TTS API 키. Gemini TTS 키를 비우면 GEMINI_API_KEY를 사용합니다.
FISH_AUDIO_API_KEY=
ELEVENLABS_API_KEY=
TYPECAST_API_KEY=
GEMINI_TTS_API_KEY=
# BytePlus ModelArk 싱가포르 리전
ARK_API_KEY=
SEEDREAM_MODEL=seedream-4-5-251128

# 자막 없는 레퍼런스용 오프라인 whisper.cpp 모델 경로 (선택)
WHISPER_MODEL_PATH=

# 기본 위치 이외에 설치한 Blender 실행 파일 (선택)
BLENDER_BIN=

# 음악·효과음용 Road Music 설치 디렉터리 (선택)
ROAD_MUSIC_HOME=

# 문서 PDF용 Chrome 또는 Chromium 실행 파일을 직접 지정할 때 (선택)
NODE_DOCUMENT_CHROME_PATH=

# Tripo 공식 API 작업 제출 및 조회 (별도 계정 청구)
TRIPO_API_KEY=
