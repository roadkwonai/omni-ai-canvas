{
  "name": "scene-room",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx --import ./scripts/start-recovery.ts node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "start": "node --import tsx --import ./scripts/start-recovery.ts node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "setup:check": "node scripts/check-setup.mjs",
    "setup:local-tts": "bash scripts/setup-local-tts.sh",
    "build": "next build",
    "lint": "eslint app components lib scripts tests",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "test:local-tts": "tsx --test tests/local-tts-worker.integration.ts",
    "test:db": "node --env-file-if-exists=.env --import tsx tests/db.integration.ts",
    "mcp": "node --import tsx scripts/canvas-mcp.ts"
  },
  "dependencies": {
    "@higgsfield/cli": "1.2.2",
    "@klingai/cli-global": "0.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neondatabase/serverless": "1.2.1",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "@xyflow/react": "12.12.1",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3"
  }
}
